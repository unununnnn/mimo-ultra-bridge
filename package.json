{
  "name": "mimo-ultra-bridge",
  "version": "1.0.0",
  "description": "Playwright Stealth Automation Bridge for Xiaomi MiMo Studio Ultra (https://aistudio.xiaomimimo.com/#/ultra) exposing OpenAI (/v1/chat/completions) and Anthropic (/v1/messages) APIs.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "login": "ts-node src/cli/login.ts",
    "push:github": "bash scripts/push-to-github.sh"
  },
  "keywords": [
    "xiaomi-mimo",
    "mimo-ultra",
    "ultraspeed",
    "playwright",
    "openai-proxy",
    "anthropic-proxy",
    "antigravity-bridge",
    "claude-code"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "playwright": "^1.48.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
