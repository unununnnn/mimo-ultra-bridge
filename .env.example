# Server Configuration
PORT=8080
HOST=127.0.0.1
API_KEYS=sk-mimo-ultra

# Playwright Automation Settings
MIMO_ULTRA_URL=https://aistudio.xiaomimimo.com/#/ultra
PROFILES_DIR=~/.xiaomi-mimo-ultra/profiles
HEADLESS=true
NAVIGATION_TIMEOUT_MS=60000
STREAM_TIMEOUT_MS=180000

# Default Model Mapping
DEFAULT_MIMO_MODEL=mimo-v2.6-pro-ultraspeed
ENABLE_THINKING_DEFAULT=true
